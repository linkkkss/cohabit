# Copy to backend/.env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-local-only
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://cohabit:cohabit_dev_pw@127.0.0.1:5433/cohabit_dev
TIME_ZONE=Asia/Shanghai
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/auth/
CAMPUS_EMAIL_DOMAINS=
INVITE_REQUIRED=false
# 邀请码已改为数据库表 accounts_invite_code（docs/03 §1.3.4）；
# 内测固定码 COHAB2026 由 seed_demo 写入或用 Django Admin「邀请码」页新建，不再读取 env 白名单。
DEV_VERIFICATION_CODE=123456
SENTRY_DSN=
